{
  "$schema": "https://json.schemastore.org/package",
  "name": "o-tiling",
  "version": "2.10.7",
  "description": "Auto-tiling extension for GNOME Shell with 'Aura' focus border, customizable workspace overview styling, and theme consistency.",
  "author": "oliwebd",
  "type": "module",
  "scripts": {
    "build": "tsc && prettier --write 'dist/**/*.js' && node scripts/format-dist.mjs",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "deploy": "pnpm run lint && pnpm run type-check && pnpm run build",
    "lint:dist": "../GER/ego-lint ./dist",
    "shexli": "make shexli",
    "log": "journalctl -f -o cat /usr/bin/gnome-shell | grep o-tiling",
    "local-install": "make install"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@girs/gjs": "4.0.0-rc.13",
    "@girs/gnome-shell": "^50.0.4",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "packageManager": "pnpm@11.17.0"
}
